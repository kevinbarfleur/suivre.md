{
  "name": "suivre.md",
  "version": "1.0.0-alpha.1",
  "description": "Markdown-native backlog with a live kanban board, CLI and MCP — built to be the issue tracker agent workflows act on. Tasks, sprints, docs and ADRs as plain .md files in your repo.",
  "type": "module",
  "license": "MIT",
  "author": "Kevin Barfleur",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinbarfleur/suivre.md.git"
  },
  "homepage": "https://github.com/kevinbarfleur/suivre.md#readme",
  "bugs": "https://github.com/kevinbarfleur/suivre.md/issues",
  "keywords": [
    "backlog",
    "kanban",
    "issue-tracker",
    "markdown",
    "agent",
    "mcp",
    "claude-code",
    "cli"
  ],
  "bin": {
    "suivre": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/domain/index.js",
    "./mcp": "./dist/mcp/index.js"
  },
  "files": [
    "dist",
    "apps/desktop/Sources",
    "apps/desktop/Package.swift",
    "apps/desktop/install.sh",
    "apps/desktop/make-app.sh",
    "apps/desktop/README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch src/server/dev.ts",
    "build": "npm run build:web && npm run build:node",
    "prepare": "npm run build",
    "build:web": "vite build",
    "build:node": "rm -f dist/*.js && rm -rf dist/cli dist/mcp dist/domain && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "unocss": "^66.7.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.37.2",
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@hono/node-server": "^2.0.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.12.30",
    "vue": "^3.5.40",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
